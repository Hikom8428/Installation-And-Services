generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("DOER") // MASTER, ADMIN, MANAGER, DOER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  raisedSiteVisits SiteVisit[]      @relation("RaisedSiteVisits")
  taskAssignments  TaskAssignment[] @relation("DoerTaskAssignments")
}

model Installation {
  id             String     @id @default(uuid())
  sourceId       String?    @unique // "Job No" from the Google Sheet, used to match rows on re-sync
  customerName   String
  customerPhone  String?
  customerAddress String?
  productDetails String?
  status         String     @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, COMPLETED
  currentCycle   Int        @default(1) // bumped each time a COMPLETED task is reopened/reassigned
  syncDate       DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  data           Json?      // raw Google Sheet values for the currently-configured display columns, keyed by column header
}

// One row per Doer assigned to a task in a given cycle — a task can have
// multiple Doers, and can be re-assigned multiple times over its life (each
// re-assignment after a COMPLETED status starts a new `cycle`). taskType +
// taskId identify which Installation/Complaint/SiteVisit this is (mirrors
// TaskStep's polymorphic pattern). fundAmount is the optional cash advance
// handed to that Doer for that task+cycle at assignment time.
model TaskAssignment {
  id         String   @id @default(uuid())
  taskType   String   // "INSTALLATION" | "COMPLAINT" | "SITE_VISIT"
  taskId     String
  doerId     String
  doer       User     @relation("DoerTaskAssignments", fields: [doerId], references: [id])
  cycle      Int      @default(1) // which round of this task this assignment belongs to
  fundAmount Float?
  fundNotes  String?
  createdAt  DateTime @default(now())

  @@unique([taskType, taskId, doerId, cycle])
}

// Singleton row (id = "default") storing which Google Sheet columns the
// Installations table should display, chosen via the "Configure Columns" UI.
model SyncConfig {
  id        String   @id @default("default")
  columns   Json     // ordered array of selected column header names
  updatedAt DateTime @updatedAt
}

// Doer's field completion flow, shared by Installation, Complaint, and
// SiteVisit tasks (taskType + taskId identify which one). One row per
// task PER CYCLE — every time a completed task is reopened for another
// round, a fresh TaskStep row is created for the new `cycle`, and the
// previous cycle's row is kept as permanent history. All 3 task types now
// use the same 3-step flow (see src/app/api/task-steps/route.ts):
//   Step 1: site photo + video, with lat/long captured automatically from
//           the device at upload time — moves the task to IN_PROGRESS.
//   Step 2: work-complete evidence upload (Installation/Complaint), or
//           visit notes + site chart/calculation upload (SiteVisit).
//   Step 3: expense amount/notes + uploaded bills — moves the task to
//           COMPLETED for that cycle.
// Master/Admin/Manager use the Step 1 lat/long to confirm the Doer was
// actually at the site.
model TaskStep {
  id            String    @id @default(uuid())
  taskType      String    // "INSTALLATION" | "COMPLAINT" | "SITE_VISIT"
  taskId        String
  cycle         Int       @default(1) // which round of this task this progress record belongs to

  sitePhotoUrl  String?
  siteVideoUrl  String?
  latitude      Float?
  longitude     Float?
  step1At       DateTime?

  evidenceUrl   String?
  notes         String?   @db.Text // SiteVisit step 2: written visit details
  chartUrl      String?             // SiteVisit step 2: uploaded site chart/calculation
  step2At       DateTime?

  expenseAmount Float?
  expenseNotes  String?
  billUrls      Json?     // array of uploaded bill file URLs
  step3At       DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([taskType, taskId, cycle])
}

// Raised internally by Manager/Admin/Master (via the dashboard's Site
// Visits tab, not the public complaint form) to schedule a Doer to visit
// a site and inspect it. serialNo auto-increments; display it as
// "SV-0001" etc. by zero-padding.
model SiteVisit {
  id             String    @id @default(uuid())
  serialNo       Int       @unique @default(autoincrement())
  raisedById     String?
  raisedBy       User?     @relation("RaisedSiteVisits", fields: [raisedById], references: [id])
  raisedVia      String?   // how the request came in — Phone Call, WhatsApp, Email, In Person, Other
  raisedByName   String?   // name of the person who requested the visit
  customerName   String
  siteAddress    String?
  siteLatitude   Float?    // picked on the map when raising the visit
  siteLongitude  Float?
  attendantName  String?
  attendantPhone String?
  visitFor       String    // DOOR | PANEL | DOOR_PANEL
  status         String    @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, COMPLETED
  currentCycle   Int       @default(1) // bumped each time a COMPLETED visit is reopened/reassigned
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Complaint {
  id                 String     @id @default(uuid())
  jobNo              String?    // at least one of jobNo / doorSerialNo is required
  doorSerialNo       String?
  warrantyStatus     String?    // IN_WARRANTY | OUT_OF_WARRANTY
  customerName       String
  customerPhone      String
  customerEmail      String?
  siteAddress        String?
  siteLatitude       Float?     // picked by the customer on the map
  siteLongitude      Float?
  attendantName      String?    // person present at the site, if different from the customer
  attendantPhone     String?
  issueDescription   String
  attachmentUrl      String?    // uploaded invoice/bill document
  mediaUrls          Json?      // uploaded problem photos/videos (array of URLs)
  status             String     @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, COMPLETED
  currentCycle       Int        @default(1) // bumped each time a COMPLETED complaint is reopened/reassigned
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}
