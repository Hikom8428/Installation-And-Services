generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("DOER") // MASTER, ADMIN, MANAGER, DOER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installations    Installation[] @relation("DoerInstallations")
  complaints       Complaint[]    @relation("DoerComplaints")
  raisedSiteVisits SiteVisit[]    @relation("RaisedSiteVisits")
  siteVisits       SiteVisit[]    @relation("DoerSiteVisits")
}

model Installation {
  id             String     @id @default(uuid())
  sourceId       String?    @unique // "Job No" from the Google Sheet, used to match rows on re-sync
  customerName   String
  customerPhone  String?
  customerAddress String?
  productDetails String?
  status         String     @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, COMPLETED
  assignedDoerId String?
  assignedDoer   User?      @relation("DoerInstallations", fields: [assignedDoerId], references: [id])
  syncDate       DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  data           Json?      // raw Google Sheet values for the currently-configured display columns, keyed by column header
}

// Singleton row (id = "default") storing which Google Sheet columns the
// Installations table should display, chosen via the "Configure Columns" UI.
model SyncConfig {
  id        String   @id @default("default")
  columns   Json     // ordered array of selected column header names
  updatedAt DateTime @updatedAt
}

// Doer's field completion flow, shared by Installation, Complaint, and
// SiteVisit tasks (taskType + taskId identify which one). One row per task.
// Installation/Complaint use all 3 steps; SiteVisit only uses steps 1-2
// (see src/app/api/task-steps/route.ts for the per-taskType rules).
//   Step 1: site photo + video, with lat/long captured automatically from
//           the device at upload time — moves the task to IN_PROGRESS.
//   Step 2: work-complete evidence upload (Installation/Complaint), or
//           visit notes + site chart/calculation upload (SiteVisit, which
//           also completes the task at this step).
//   Step 3: expense amount/notes + uploaded bills — moves the task to
//           COMPLETED. (Installation/Complaint only.)
// Master/Admin/Manager use the Step 1 lat/long to confirm the Doer was
// actually at the site.
model TaskStep {
  id            String    @id @default(uuid())
  taskType      String    // "INSTALLATION" | "COMPLAINT" | "SITE_VISIT"
  taskId        String

  sitePhotoUrl  String?
  siteVideoUrl  String?
  latitude      Float?
  longitude     Float?
  step1At       DateTime?

  evidenceUrl   String?
  notes         String?   @db.Text // SiteVisit step 2: written visit details
  chartUrl      String?             // SiteVisit step 2: uploaded site chart/calculation
  step2At       DateTime?

  expenseAmount Float?
  expenseNotes  String?
  billUrls      Json?     // array of uploaded bill file URLs
  step3At       DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([taskType, taskId])
}

// Raised internally by Manager/Admin/Master (via the dashboard's Site
// Visits tab, not the public complaint form) to schedule a Doer to visit
// a site and inspect it. serialNo auto-increments; display it as
// "SV-0001" etc. by zero-padding.
model SiteVisit {
  id             String    @id @default(uuid())
  serialNo       Int       @unique @default(autoincrement())
  raisedById     String?
  raisedBy       User?     @relation("RaisedSiteVisits", fields: [raisedById], references: [id])
  customerName   String
  siteAddress    String?
  siteLatitude   Float?    // picked on the map when raising the visit
  siteLongitude  Float?
  attendantName  String?
  attendantPhone String?
  visitFor       String    // DOOR | PANEL | DOOR_PANEL
  status         String    @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, COMPLETED
  assignedDoerId String?
  assignedDoer   User?     @relation("DoerSiteVisits", fields: [assignedDoerId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Complaint {
  id                 String     @id @default(uuid())
  jobNo              String?    // at least one of jobNo / doorSerialNo is required
  doorSerialNo       String?
  customerName       String
  customerPhone      String
  customerEmail      String?
  siteAddress        String?
  siteLatitude       Float?     // picked by the customer on the map
  siteLongitude      Float?
  attendantName      String?    // person present at the site, if different from the customer
  attendantPhone     String?
  issueDescription   String
  attachmentUrl      String?    // uploaded invoice/bill document
  mediaUrls          Json?      // uploaded problem photos/videos (array of URLs)
  status             String     @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, COMPLETED
  assignedDoerId     String?
  assignedDoer       User?      @relation("DoerComplaints", fields: [assignedDoerId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}
